<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="."/>

        <!-- Exclure les fichiers volumineux qui peuvent être retéléchargés -->
        <exclude domain="file" path="pdfs"/>
        <exclude domain="file" path="catalogue"/>

        <!-- Exclure les identifiants spécifiques à l'appareil (Firebase / App Check) -->
        <exclude domain="sharedpref" path="com.google.firebase.appcheck.store.xml"/>
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml"/>
        <exclude domain="file" path="pdfs/" />
        <exclude domain="file" path="catalogue/" />
        <exclude domain="sharedpref" path="com.google.firebase.appcheck.store.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
    </cloud-backup>

    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="."/>

        <!-- Exclure les fichiers volumineux qui peuvent être retéléchargés -->
        <exclude domain="file" path="pdfs"/>
        <exclude domain="file" path="catalogue"/>

        <!-- Exclure les identifiants spécifiques à l'appareil (Firebase / App Check) -->
        <exclude domain="sharedpref" path="com.google.firebase.appcheck.store.xml"/>
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml"/>
        <exclude domain="file" path="pdfs/" />
        <exclude domain="file" path="catalogue/" />
        <exclude domain="sharedpref" path="com.google.firebase.appcheck.store.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
    </device-transfer>
</data-extraction-rules>
